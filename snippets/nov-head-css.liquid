{% comment %}
  Critical, render-blocking stylesheets (layout, grid, icons, sliders).
{% endcomment %}
{% comment %}
  vendor-head.min.css = material-design-iconic-font.min.css + bootstrap.min.css + font-awesome.min.css
  concatenated (one request instead of three). Rebuild it if any of those files change.
{% endcomment %}
{{ 'vendor-head.min.css' | asset_url | stylesheet_tag }}
{{ 'common.scss.css' | asset_url | stylesheet_tag }}
{% render 'owl-inline-css' %}
{{ 'slick.scss.css' | asset_url | stylesheet_tag }}
{% comment %}
  jquery.mmenu.all.css must stay render-blocking: the off-canvas menu is initialised by
  global.js on DOMContentLoaded and breaks (panels end up outside the drawer) if that
  CSS is still loading at that moment.
{% endcomment %}
{{ 'jquery.mmenu.all.css' | asset_url | stylesheet_tag }}
{{ 'layout.scss.css' | asset_url | stylesheet_tag }}
{{ 'theme.scss.css' | asset_url | stylesheet_tag }}
{% if settings.enable_rtl == true %}
{{ 'theme-rtl.scss.css' | asset_url | stylesheet_tag }}
{% endif %}
{{ 'responsive.scss.css' | asset_url | stylesheet_tag }}

{% comment %}
  Non-critical stylesheets (animations, lightboxes, popups, carousel nav theme).
  Loaded without blocking the first paint: fetched as "print" media, then
  switched to "all" once downloaded. <noscript> keeps them working without JS.
{% endcomment %}
{%- comment -%}
  jquery.ui.min.css is no longer loaded: the theme uses no jQuery UI widgets
  (the jQuery UI code was also removed from vendor.js).
{%- endcomment -%}
{%- assign deferred_css = 'animate.min.css,owl.theme.default.css,jquery.fancybox.css,magnific-popup.css' | split: ',' -%}
{%- for css in deferred_css -%}
<link rel="stylesheet" href="{{ css | asset_url }}" media="print" onload="this.media='all'; this.onload=null;">
<noscript>{{ css | asset_url | stylesheet_tag }}</noscript>
{%- endfor -%}
