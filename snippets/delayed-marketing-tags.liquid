{%- comment -%}
  Google Tag Manager (GTM-TCNZZ8XP) loaded AFTER the page is interactive instead of in the
  critical path.

  - window.dataLayer is created immediately, so pushes made before GTM arrives (e.g. the
    initiated_checkout and custom_purchase_complete events in theme.liquid) are queued and
    processed by GTM once it loads. Nothing is lost.
  - gtm.js is injected on the first REAL user interaction (scroll, touch, mouse move, key press,
    click, wheel; script-dispatched events are ignored) OR 5 seconds after the window "load"
    event, whichever comes first.

  The Meta Pixel (548519410929159) and Microsoft Clarity (mgy3jsx4mu) are NOT loaded by the
  theme any more: Shopify's Facebook & Instagram channel and the Clarity app already install
  the same pixel / project through Shopify Web Pixels (and GTM carries a Clarity tag as well),
  so the theme copies only produced duplicate PageView events and extra downloads.
{%- endcomment -%}
<script>
(function (w, d) {
  w.dataLayer = w.dataLayer || [];

  var loaded = false;
  function loadTags() {
    if (loaded) return;
    loaded = true;
    /* Google Tag Manager (standard snippet, just started later) */
    w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var s = d.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-TCNZZ8XP';
    d.head.appendChild(s);
  }

  var events = ['scroll', 'mousemove', 'touchstart', 'keydown', 'click', 'wheel', 'pointerdown'];
  function onFirstInteraction(e) {
    /* only real user input counts; events dispatched by scripts (isTrusted === false) are ignored */
    if (e && e.isTrusted === false) return;
    for (var i = 0; i < events.length; i++) w.removeEventListener(events[i], onFirstInteraction);
    loadTags();
  }
  for (var i = 0; i < events.length; i++) w.addEventListener(events[i], onFirstInteraction, { passive: true });

  function armFallback() { w.setTimeout(loadTags, 5000); }
  if (d.readyState === 'complete') armFallback();
  else w.addEventListener('load', armFallback);

  /* allow other scripts to force-load GTM, e.g. before navigating away */
  w.__loadMarketingTags = loadTags;
})(window, document);
</script>
