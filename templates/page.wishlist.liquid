{% include 'nov-breadcrumb' %}

<main class="main-content" id="MainContent" role="main" tabindex="-1">
  <div class="wishlist-page">
    <div class="container">
      <div class="title_block pt-10 wishlist-page__header">
        <h1>{{ 'wishlist.wishlist.wishlists_title' | t }}</h1>
        <span class="wishlist-page__count"><span class="WishlistCount">0</span> items</span>
      </div>
      <div class="wrapper-wishlist">
        <div class="wishlist-product" data-wishlist-content>
          <div class="wrapper-overflow">
            <div class="wishlist-header d-md-block d-none">
              <div class="row">
                <div class="column col-xl-5 col-lg-5 col-md-4 col-sm-5 col-xs-12">
                  <div class="column_name">
                    <div class="column_icon"><i class="zmdi zmdi-favorite"></i></div>
                    <div class="column_title">{{ 'wishlist.wishlist.wishlist_title' | t }}</div>
                  </div>
                </div>
                <div class="column col-xl-3 col-lg-3 col-md-2 col-sm-3 col-xs-12">
                  <div class="column_price">
                    <div class="column_icon"><i class="fa custom-dhs" aria-hidden="true">DHS</i></div>
                    <div class="column_title">{{ 'wishlist.wishlist.wishlist_price' | t }}</div>
                  </div>
                </div>
                <!-- <div class="column col-xl-2 col-lg-2 col-md-3 col-sm-2 col-xs-12">
                  <div class="column_remove">
                    <div class="column_icon"><i class="fa fa-trash-o" aria-hidden="true"></i></div>
                    <div class="column_title">{{ 'wishlist.wishlist.wishlist_remove' | t }}</div>
                  </div>
                </div> -->
        <!-- <div class="column col-xl-2 col-lg-2 col-md-3 col-sm-2 col-xs-12">
    <a
      href="#"
      class="column_remove"
      onclick="removeFromWishlist(this, '{{ product.handle }}'); return false;"
    >
      <div class="column_icon">
        <i class="fa fa-trash-o" aria-hidden="true"></i>
      </div>
      <div class="column_title">{{ 'wishlist.wishlist.wishlist_remove' | t }}</div>
    </a>
  </div> -->
                <div class="column col-xl-2 col-lg-2 col-md-3 col-sm-2 col-xs-12">
                  <div class="column_add_cart">
                    <div class="column_icon"><i class="zmdi zmdi-shopping-cart"></i></div>
                    <div class="column_title">{{ 'wishlist.wishlist.wishlist_add_to_cart' | t }}</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="wishlist-content" data-wishlist-container></div>
            <div class="wishlist-empty" data-wishlist-empty hidden>
              <i class="zmdi zmdi-favorite-outline" aria-hidden="true"></i>
              <h2>Your wishlist is empty</h2>
              <p>Save the pieces you love and find them here anytime.</p>
              <a href="/collections/all" class="btn">Continue shopping</a>
            </div>
            <script>
              // Show the empty state when the (localStorage) wishlist has no products; re-check after removals.
              (function () {
                var empty = document.querySelector('[data-wishlist-empty]');
                if (!empty) return;
                function check() {
                  var list = [];
                  try { list = JSON.parse(localStorage.getItem('wishListsArr') || '[]'); } catch (e) { list = []; }
                  list = Array.isArray(list) ? list.filter(function (h) { return typeof h === 'string' && h.trim() !== ''; }) : [];
                  empty.hidden = list.length > 0;
                }
                check();
                document.addEventListener('wishlist:removed', function () { setTimeout(check, 350); });
                document.addEventListener('wishlist:added', check);
              })();
            </script>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<style>
    .fa.custom-dhs {
      font-family: Arial, sans-serif;
      font-weight:bold;

  }
  .wishlist-page .wrapper-wishlist .wishlist-header .column .column_icon i{
     font-size:1rem;
  }
</style>
