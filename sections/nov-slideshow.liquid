<style>
  /* width/height attributes reserve the slide's space before the image loads (no layout shift);
     :where() keeps this rule at zero specificity so any theme CSS height still wins. */
  :where(.slideshow .slide-image img[width][height]) { height: auto; }
  /* slick sets slide images to display:block on init; apply it up front so the
     slideshow has the same height before and after init (no shift, stable LCP). */
  .slideshow .slide-image img { display: block; }
  .slideshow .slide-image picture { display: block; width: 100%; }
  /* The theme zeroes the slide <figure> margin only under .slick-slide (after init);
     without this the pre-init figure keeps Bootstrap's bottom margin and the whole
     page below the slideshow jumps up when the slider initialises. */
  .slideshow .main-slider .item figure { margin: 0; }
  /* The theme keeps .main-slider invisible (opacity 0) until the slider script initialises,
     which delays the hero image's first paint until all JS has run. Show the first slide
     immediately and hide the others until slick takes over (same final layout). */
  .slideshow .main-slider:not(.slick-initialized) { opacity: 1; visibility: visible; }
  .slideshow .main-slider:not(.slick-initialized) .item:not(:first-child) { display: none; }

  /* Furniture Bundles slide: real "Shop Bundle Offers" button over the banner artwork (the artwork
     has no button). The slideshow is full-width, so vw sizes scale with the artwork; positions are
     percentages of the slide image. Desktop artwork >= 992px, mobile artwork below (theme breakpoint). */
  .slideshow .slide-image { position: relative; }
  .slideshow .bundle-cta__btn,
  .slideshow .bundle-cta__more {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    box-sizing: border-box;
    margin: 0;
    background-color: #b3121b;
    color: #fff;
    font-family: Garamond, "EB Garamond", Georgia, "Times New Roman", serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 0.25em 0.9em rgba(0, 0, 0, 0.28);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .slideshow .bundle-cta__btn:hover,
  .slideshow .bundle-cta__btn:focus-visible,
  .slideshow .bundle-cta__more:hover,
  .slideshow .bundle-cta__more:focus-visible {
    background-color: #8e0e15;
    color: #fff;
    text-decoration: none;
  }
  .slideshow .bundle-cta__btn:focus-visible,
  .slideshow .bundle-cta__more:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  /* Desktop artwork: one button in the left text column, under the headline */
  .slideshow .bundle-cta__btn {
    left: 5.9%;
    top: 56.8%;
    font-size: 1.55vw;
    padding: 0.72em 1.7em 0.66em;
    border-radius: 0.5vw;
  }
  .slideshow .bundle-cta__btn:hover { transform: translateY(-1px); }
  .slideshow .bundle-cta__chevron,
  .slideshow .bundle-cta__more { display: none; }
  @media (max-width: 991px) {
    /* Mobile artwork: centred button under the headline + "see more" pill at the bottom */
    .slideshow .bundle-cta__btn {
      left: 50%;
      top: 17.6%;
      transform: translateX(-50%);
      font-size: 2.7vw;
      padding: 0.62em 1.5em 0.56em;
      border-radius: 1.2vw;
    }
    .slideshow .bundle-cta__btn:hover { transform: translateX(-50%) translateY(-1px); }
    .slideshow .bundle-cta__chevron { display: inline-block; font-size: 1.3em; line-height: 0.75; }
    .slideshow .bundle-cta__more {
      display: inline-flex;
      left: 50%;
      top: 91.6%;
      transform: translateX(-50%);
      font-size: 2.8vw;
      padding: 0.5em 1.6em 0.45em;
      border-radius: 2vw;
    }
    .slideshow .bundle-cta__more:hover { transform: translateX(-50%) translateY(-1px); }
    .slideshow .bundle-cta__more svg { width: 1.1em; height: 1.1em; flex: none; }
  }
</style>
<div class="distance{% if section.settings.class != blank %} {{ section.settings.class }}{% endif %}">
  {% if section.settings.has_fullwidth == false %}
    <div class="container">
  {% endif %}

  {% comment %} Slideshow {% endcomment %}
  <div data-section-id="{{ section.id }}" data-section-type="slideshow-section" class="slideshow">
    {% if section.blocks.size > 0 %}
      <div
        class="main-slider"
        data-autoplay="{{ section.settings.autoplay }}"
        data-speed="{{ section.settings.autoplay_speed }}"
        data-arrows="{{ section.settings.arrows }}"
        data-dots="{{ section.settings.dots }}"
      >
        {% for block in section.blocks %}
          {% if block.type == 'image' %}
            <div class="item image">
              <figure>
                <div class="slide-image slide-media{% if section.settings.zoomImg == true %} ani_img{% endif %}">
                  {%- comment -%}
                    Responsive slide image. The first slide is the hero / LCP image,
                    so it gets fetchpriority="high"; later slides load at low priority.
                  {%- endcomment -%}
                  {%- assign slide_mobile_image = block.settings.image_mobile -%}
                  {%- if forloop.first -%}
                    {%- comment -%}
                      Markers read by layout/theme.liquid to emit <link rel="preload"> tags in <head>:
                      LCPD = desktop image (min-width: 992px), LCPS = mobile image (max-width: 991px, only when set).
                    {%- endcomment -%}
                    <!--LCPD|{{ block.settings.image | image_url: width: 1920 }}|{% render 'nov-srcset', image: block.settings.image %}|100vw-->
                    {%- if slide_mobile_image != blank -%}
                    <!--LCPS|{{ slide_mobile_image | image_url: width: 1920 }}|{% render 'nov-srcset', image: slide_mobile_image %}|100vw-->
                    {%- endif -%}
                  {%- endif -%}
                  {%- capture slide_img -%}
                    <picture>
                      {%- if slide_mobile_image != blank -%}
                      {%- comment -%} Separate artwork for phones / portrait tablets; the browser picks this source below 992px {%- endcomment -%}
                      <source
                        media="(max-width: 991px)"
                        srcset="{% render 'nov-srcset', image: slide_mobile_image %}"
                        sizes="100vw"
                        width="{{ slide_mobile_image.width }}"
                        height="{{ slide_mobile_image.height }}"
                      >
                      {%- endif -%}
                      <img
                        src="{{ block.settings.image | image_url: width: 1920 }}"
                        srcset="{% render 'nov-srcset', image: block.settings.image %}"
                        sizes="100vw"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        class="image-entity"
                        alt="{{ block.settings.image.alt | default: 'slidershow' | escape }}"
                        {% if forloop.first %}fetchpriority="high"{% else %}fetchpriority="low"{% endif %}
                      >
                    </picture>
                  {%- endcapture -%}
                  {% if block.settings.slider_link != blank %}
                    <a href="{{ block.settings.slider_link }}" style="width: 100%;">
                      {{ slide_img }}
                    </a>
                  {% else %}
                    {{ slide_img }}
                  {% endif %}
                  {%- comment -%}
                    Furniture Bundles slide: the banner artwork has no button baked in, so a real
                    "Shop Bundle Offers" button is drawn over it (desktop: under the headline text;
                    mobile: under the headline, plus a "Click to see more bundles" pill at the bottom).
                    Both link where the slide links. Positions/sizes live in the <style> block above.
                  {%- endcomment -%}
                  {%- assign slide_link = block.settings.slider_link | default: '' -%}
                  {%- if slide_link contains 'furniture-bundles' -%}
                    <a class="bundle-cta__btn" href="{{ slide_link }}">Shop Bundle Offers<span class="bundle-cta__chevron" aria-hidden="true">&rsaquo;</span></a>
                    <a class="bundle-cta__more" href="{{ slide_link }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7 2v16l4.3-3.7 2.7 5.7 2.5-1.1-2.7-5.6 5.2-.3z"/></svg>Click to see more bundles</a>
                  {%- endif -%}
                </div>

                <figcaption class="caption">
                  <div class="content-caption content-captiont-{{ forloop.index }} {% if block.settings.text_align == 'left' %}rtl-left {% elsif block.settings.text_align == 'right' %}rtl-right {% else %}rtl-center{% endif %}">
                    <div class="position-relative">
                      <div class="content position-absolute content-{{ forloop.index }}">
                        {% unless block.settings.caption_1 == blank %}
                          <div
                            class="caption-animate caption-1 mb-10"
                            data-animate="{{ block.settings.cap_animate_1 }} animated"
                            style="color: {{ block.settings.color_cap1 }};"
                          >
                            {{ block.settings.caption_1 | nofilter }}
                          </div>
                        {% endunless %}
                        {% unless block.settings.caption_2 == blank %}
                          <div
                            class="caption-animate caption-2"
                            data-animate="{{ block.settings.cap_animate_2 }} animated"
                            style="color: {{ block.settings.color_cap2 }};"
                          >
                            {{ block.settings.caption_2 | nofilter }}
                          </div>
                        {% endunless %}
                        {% unless block.settings.caption_3 == blank %}
                          <div
                            class="caption-animate caption-3 mt-10"
                            data-animate="{{ block.settings.cap_animate_3 }} animated"
                            style="color: {{ block.settings.color_cap3 }};"
                          >
                            {{ block.settings.caption_3 | nofilter }}
                          </div>
                        {% endunless %}
                        {% unless block.settings.caption_btn == blank %}
                          <a
                            class="caption-animate caption-btn mt-30 mt-md-10"
                            data-animate="{{ block.settings.cap_animate_btn }} animated"
                            href="{{ block.settings.slider_link }}"
                            style="color: {{ block.settings.color_btn }};background-color: {{ block.settings.bg_btn }};"
                          >
                            {{ block.settings.caption_btn | nofilter }}
                          </a>
                        {% endunless %}
                      </div>
                    </div>
                  </div>
                </figcaption>
              </figure>
            </div>
          {% endif %}
          {% if block.type == 'video' %}
            <div class="item video">
              <video playsinline autoplay loop muted style="width: 100%;max-width: 100%; height: auto;">
                <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
            </div>
          {% endif %}
          {% if block.settings.image == blank and block.settings.video != blank %}
            <div class="item image blank">
              <figure>
                {% capture current %}{% cycle 1, 2 %}{% endcapture %}
                {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                <figcaption class="caption-animate caption {% if block.settings.type_caption == '1' %}type_1{else}type_2{% endif %}">
                  {% unless block.settings.caption_1 == blank %}
                    <div class="caption-animate caption-1">{{ block.settings.caption_1 }}</div>
                  {% endunless %}
                  {% unless block.settings.caption_2 == blank %}
                    <div class="caption-animate caption-2" data-animate="bounceInRight">
                      {{ block.settings.caption_2 | nofilter }}
                    </div>
                  {% endunless %}
                  {% unless block.settings.caption_3 == blank %}
                    <div class="caption-animate caption-3" data-animate="bounceInLeft">
                      {{ block.settings.caption_3 | nofilter }}
                    </div>
                  {% endunless %}
                </figcaption>
              </figure>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    {% if section.blocks.size == 0 %}
      <div class="placeholder-noblocks">
        {{ 'homepage.onboarding.no_content' | t }}
      </div>
    {% endif %}
  </div>
  {% comment %} End Slideshow {% endcomment %}

  {% if section.settings.has_fullwidth == false %}
    </div>
  {% endif %}
</div>

