{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    { "type": "header", "content": "Scrolling text" },
    { "type": "text", "id": "announcement_text_4", "label": "Scrolling text", "default": "CLOSING DOWN SALE • UP TO 70% OFF • EVERYTHING MUST GO • WHILE STOCKS LAST", "info": "Scrolls continuously across the bar. Leave empty to hide." },
    { "type": "color", "id": "announcement_text_4_color", "label": "Scrolling text color", "default": "#ffffff" },
    { "type": "range", "id": "marquee_duration", "label": "Scroll speed (seconds per loop)", "min": 10, "max": 90, "step": 5, "unit": "s", "default": 40, "info": "Lower is faster." },
    { "type": "header", "content": "Info boxes" },
    { "type": "checkbox", "id": "show_info_boxes", "label": "Show the three info boxes", "default": false },
    { "type": "text", "id": "announcement_text_1", "label": "Announcement Text 1", "default": "Next Day Delivery in Dubai" },
    { "type": "text", "id": "announcement_text_2", "label": "Announcement Text 2", "default": "Free Shipping above AED 1,000" },
    { "type": "text", "id": "announcement_text_3", "label": "Announcement Text 3", "default": "Try Before You Buy" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#A9010C" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Announcement Bar" }]
}
{% endschema %}
<style>
.announcement-bar {
  background: {{ section.settings.background_color }};
  color: {{ section.settings.text_color }};
  padding: 8px 0;
  font-size: 16px;
  font-weight: 700;
  overflow: hidden;
}
.announce-box {
  position: relative;
  padding: 1px;
  border-radius: 4px;
  overflow: hidden;
  /* Refined metallic-taupe gradient edge for a luxury finish */
  background: linear-gradient(135deg, #c7bca4 0%, #afa183 45%, #8d8167 55%, #afa183 100%);
}

.announce-inner {
  position: relative;
  z-index: 3;
  background: {{ section.settings.background_color }};
  padding: 7px 14px;
  border-radius: 3px;
  text-align: center;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 14px;
}

@media (max-width: 991px) {
  .announce-box { margin-bottom: 10px; }
}

/* Continuously scrolling sale text (pure CSS, pauses on hover) */
.announce-marquee {
  overflow: hidden;
  white-space: nowrap;
  color: {{ section.settings.announcement_text_4_color }};
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  line-height: 1.6;
  padding: 2px 0;
}
.announce-marquee__track {
  display: inline-flex;
  width: max-content;
  animation: announce-marquee {{ section.settings.marquee_duration | default: 30 }}s linear infinite;
  will-change: transform;
}
.announce-marquee__group {
  display: inline-flex;
  flex: none;
}
.announce-marquee__item {
  padding: 0 2.5em;
  /* thin divider between repeats */
  border-left: 1px solid {{ section.settings.announcement_text_4_color | color_modify: 'alpha', 0.55 }};
}
.announce-marquee:hover .announce-marquee__track {
  animation-play-state: paused;
}
@keyframes announce-marquee {
  from { transform: translate3d(0, 0, 0); }
  to   { transform: translate3d(-50%, 0, 0); }
}
@media (prefers-reduced-motion: reduce) {
  .announce-marquee__track { animation: none; }
}
</style>

<div class="container-fluid announcement-bar px-2">

  {% if section.settings.announcement_text_4 != blank %}
    {%- comment -%}
      Two identical groups scroll by exactly one group width (-50%), so the loop is seamless.
      Only the first copy is exposed to screen readers.
    {%- endcomment -%}
    <div class="announce-marquee" role="region" aria-label="{{ section.settings.announcement_text_4 | escape }}">
      <div class="announce-marquee__track">
        {% for group in (1..2) %}
          <div class="announce-marquee__group"{% if group > 1 %} aria-hidden="true"{% endif %}>
            {% for copy in (1..4) %}
              <span class="announce-marquee__item"{% if group == 1 and copy > 1 %} aria-hidden="true"{% endif %}>{{ section.settings.announcement_text_4 }}</span>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_info_boxes %}
  <div class="container">
    <div class="row text-center justify-content-center">

      <div class="col-12 col-md-4 announce-box">
        <div class="announce-inner">{{ section.settings.announcement_text_1 }}</div>
      </div>

      <div class="col-12 col-md-4 announce-box">
        <div class="announce-inner">{{ section.settings.announcement_text_2 }}</div>
      </div>

      <div class="col-12 col-md-4 announce-box">
        <div class="announce-inner">{{ section.settings.announcement_text_3 }}</div>
      </div>

    </div>
  </div>
  {% endif %}

</div>
